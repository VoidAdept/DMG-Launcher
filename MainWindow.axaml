<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DMGLauncher.MainWindow"
        Title="DMG Launcher" Width="960" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#14121A">
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Background="#1E1A26" Padding="16,10" BorderBrush="#902631" BorderThickness="0,0,0,2">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Name="Banner" Height="56" Margin="0,0,16,0" />
        <TextBlock Grid.Column="1" Classes="title" Text="Duel Monsters Genesis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Name="HeaderKey" VerticalAlignment="Center" Opacity="0.8" />
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <!-- Startup checks -->
      <StackPanel Name="StartupPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="420">
        <TextBlock Name="StartupText" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Starting…" />
        <ProgressBar IsIndeterminate="True" />
      </StackPanel>

      <!-- Login (mirrors the BYOND pager) -->
      <Border Name="LoginPanel" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="420" Padding="24" CornerRadius="8" Background="#1E1A26">
        <StackPanel Spacing="12">
          <TextBlock Classes="title" Text="BYOND Account" />
          <TextBlock Name="LoginStatus" TextWrapping="Wrap" />
          <Button Name="ContinueButton" Classes="accent" Content="Continue" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Click="Continue_Click" />
          <Button Name="SignInButton" Content="Sign in with BYOND" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Click="SignIn_Click" />
          <Button Content="Create an Account" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Click="CreateAccount_Click" />
          <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                     Text="The launcher never asks for your password. Sign in through the BYOND pager; games are joined as whichever key BYOND is signed in as." />
        </StackPanel>
      </Border>

      <!-- Main menu -->
      <TabControl Name="MainTabs" IsVisible="False" Margin="12,4">
        <TabItem Header="Server List">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,8">
              <Button Content="Refresh" Click="Refresh_Click" />
              <TextBlock Name="ServerStatus" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <ScrollViewer><StackPanel Name="ServerRows" Spacing="6" /></ScrollViewer>
          </DockPanel>
        </TabItem>

        <TabItem Header="Friends">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,8">
              <TextBox Name="FriendInput" Watermark="BYOND key" Width="260" KeyDown="FriendInput_KeyDown" />
              <Button Content="Add Friend" Click="AddFriend_Click" />
              <TextBlock Name="FriendStatus" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" FontSize="11" Opacity="0.6" Margin="0,8" TextWrapping="Wrap"
                       Text="BYOND doesn't publish general online status, so friends show as online only while they're on a DMG server. Status refreshes with the server list." />
            <ScrollViewer><StackPanel Name="FriendRows" Spacing="6" /></ScrollViewer>
          </DockPanel>
        </TabItem>

        <TabItem Header="Options">
          <StackPanel Spacing="12" Margin="0,8" HorizontalAlignment="Left" Width="460">
            <TextBlock Name="VersionText" />
            <TextBlock Name="KeyText" />
            <CheckBox Name="UpdatesOnStart" Content="Check for launcher updates on start" IsCheckedChanged="UpdatesOnStart_Changed" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="Check for Updates" Click="CheckUpdates_Click" />
              <TextBlock Name="UpdateStatus" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <Button Content="Reset Settings" Click="ResetSettings_Click" />
            <Button Content="Clear Stored Data" Click="ClearData_Click" />
            <TextBlock Name="OptionsStatus" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
        </TabItem>
      </TabControl>
    </Panel>

    <!-- Modal prompt -->
    <Border Name="Overlay" Grid.RowSpan="2" IsVisible="False" Background="#C0000000">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="24" CornerRadius="8"
              Background="#1E1A26" BorderBrush="#902631" BorderThickness="1">
        <StackPanel Spacing="16">
          <TextBlock Name="AskText" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="AskYes" Classes="accent" Click="AskYes_Click" />
            <Button Name="AskNo" Click="AskNo_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
